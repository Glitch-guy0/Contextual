{
  "name": "contextual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun apps/platform/src/server.ts",
    "start": "bun apps/platform/src/server.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "bun test",
    "dev:doctor": "bun run packages/config/src/doctor/cli.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "infra:ps": "docker compose -f infra/compose.yaml ps",
    "local:up": "docker compose -f infra/compose.local.yaml up -d --build",
    "local:down": "docker compose -f infra/compose.local.yaml down --rmi local",
    "local:logs": "docker compose -f infra/compose.local.yaml logs -f app",
    "local:ps": "docker compose -f infra/compose.local.yaml ps"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.22",
  "dependencies": {
    "uuid": "14.0.3"
  }
}
