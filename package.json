{
  "name": "contextual",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "bun test",
    "dev:doctor": "bun run packages/config/src/doctor/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.22",
  "dependencies": {
    "uuid": "14.0.3"
  }
}
