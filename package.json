{
  "name": "contextual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "bun test",
    "dev:doctor": "bun run packages/config/src/doctor/cli.ts",
    "docker:up": "docker compose -f infra/compose.yaml up -d",
    "docker:down": "docker compose -f infra/compose.yaml down",
    "docker:logs": "docker compose -f infra/compose.yaml logs -f",
    "docker:ps": "docker compose -f infra/compose.yaml ps",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "infra:ps": "docker compose -f infra/compose.yaml ps"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.22",
  "dependencies": {
    "uuid": "14.0.3"
  }
}
