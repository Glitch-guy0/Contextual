# Local Containerized Development Environment Configuration
# Contextual AI Platform (infra/compose.yaml)

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=contextual_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/contextual_dev

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
