# ==============================================================================
# Contextual AI Platform — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy to .env for local development: cp .env.example .env
# Values below are configured for the local Docker Compose stack (infra/compose.yaml).

# --- Application Runtime ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Local Container Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/contextual_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=contextual_dev

# --- Local Container Cache (Redis 7) ---
REDIS_URL=redis://localhost:6379

# --- Clerk Authentication (Social OAuth: Google & GitHub) ---
# Obtain development keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret

# --- Telemetry & Health ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
